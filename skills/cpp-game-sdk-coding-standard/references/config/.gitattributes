* text=auto

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and project files
*.c text
*.cc text
*.cpp text
*.cxx text
*.h text
*.hh text
*.hpp text
*.hxx text
*.inl text
*.ixx text
*.cmake text
CMakeLists.txt text
*.md text
*.json text
*.yml text
*.yaml text
*.toml text

# Common binary and game asset formats.
# Enable Git LFS only if the target repository uses Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
